import wollok.game.*
import niveles.*
import personaje.*
// Importar archivo con los objetos de jugador y meta

describe "Tests de la base de niveles" {
    
    const nivelPrueba = new Nivel(
        posicionSpawn = game.at(2, 2),
        posicionMeta = game.at(15, 5)
    )

    test "Al configurar el spawn, el jugador se ubica exactamente en la posicion inicial del nivel" {
        nivelPrueba.configurarSpawn()
        
        assert.equals(game.at(2, 2), personaje.position())
    }

    test "Al configurar la meta, esta se ubica en la posicion designada" {
        nivelPrueba.configurarMeta()
        assert.equals(game.at(15, 5), meta.position())
    }
}   