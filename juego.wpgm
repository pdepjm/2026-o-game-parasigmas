import wollok.game.*
import personaje.*
import controles.*
 
program MiJuego {
    game.title("Prototipo de Movimiento Fino")
    
    
    game.cellSize(10)
    
    
    game.height(150)
    game.width(250)

    game.addVisual(personaje)
    
    configuracionControles.configurar()

   
    game.onTick(14, "bucleFisica", { personaje.actualizarFisica() })

    game.start()
}