import wollok.game.*
import personaje.*
import controles.*
import obstaculos.*
import paredesPiso.*
 
program MiJuego { 
    game.title("Prototipo de Movimiento Fino")
    
    game.cellSize(10)
        
    game.height(150)
    game.width(250)

    game.addVisual(personaje)

    const pinche1 = new Pinche(position = game.at(10, 0))
    const pinche2 = new Pinche(position = game.at(11, 0))
    const sierra1 = new Sierra(position = game.at(20, 5))

    //game.addVisual(pinche1)
    //game.addVisual(pinche2)
    //game.addVisual(sierra1)

    game.onCollideDo(personaje, { elemento => elemento.chocar(personaje) }) //cuando el personaje choca con un obstaculo, se ejecuta el metodo chocar de ese obstaculo
    configuracionControles.configurar()

    const pasto = new Pasto(position = game.at(-1,-1))
    game.addVisual(pasto)
    
    // limites del mundo "gruesos" (celdas 0 a 3 y celdas 230 a 233) para evitar que traspase personaje
    creadorDeHitboxes.crearParedIzquierda(0, 3, 5)

    creadorDeHitboxes.crearParedDerecha(230, 233, 5)

    game.addVisual(muroPrueba)
    creadorDeHitboxes.crearParedDerecha(130, 133, 5)

    game.onTick(25, "bucleFisica", { personaje.actualizarFisica() })

    game.start()
}